  </ItemGroup>

  <ItemGroup>
    <None Remove="SQLScript\1_script-geographic-info.sql" />
    <None Remove="SQLScript\6_script_mapping-import.sql" />
    <None Remove="SQLScript\tr_WorklistToHistory.sql" />
  </ItemGroup>

